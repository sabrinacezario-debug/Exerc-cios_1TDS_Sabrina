#include <stdio.h>

int main() {
	int n;
	int i;
	int j;
	int numero = 1;

	printf("Digite o numero de linhas para o triangulo de Floyd: ");
	scanf("%d", &n);

	printf("Triangulo de Floyd para n = %d:\n", n);

	for (i = 1; i <= n; i++) {
		for (j = 1; j <= i; j++) {
			printf("%d ", numero++);
		}
		printf("\n");
	}

	return 0;
}
